# Cloudflare Pages headers.
#
# The Parquet files are fetched whole, once per page load (see src/lib/db.js),
# so they need no Range support, only a short cache: a data rebuild replaces them.
/data/*
  Cache-Control: public, max-age=3600, must-revalidate

# Hashed filenames, so these are safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
